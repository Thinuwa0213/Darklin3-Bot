{
  "name": "@darklin3_bot/worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Darklin3 Bot Discord worker process foundation (docs/adr/0005-discord-runtime.md) — lifecycle/signal handling and config boundary only, no Discord Gateway connection yet.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run src",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "darklin3_bot": {
    "testGates": {
      "unit": true,
      "integration": true,
      "e2e": false
    }
  },
  "dependencies": {
    "@darklin3_bot/config": "workspace:*",
    "@darklin3_bot/logger": "workspace:*",
    "@napi-rs/canvas": "^1.0.10",
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@darklin3_bot/api": "workspace:*",
    "@darklin3_bot/db": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
